# Supabase project URL and publishable (anon) key. Both have safe defaults
# baked into nuxt.config.ts so the static GitHub Pages build needs no env
# vars at all. Override these locally if you want to point at a staging
# project. The publishable key is safe to commit/ship — RLS protects data.
NUXT_PUBLIC_SUPABASE_URL=https://qtknfcplbxgtmrzxocfu.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Override the asset bucket base URL if you mirror artwork to another bucket.
# Default is also baked into nuxt.config.ts.
NUXT_PUBLIC_ASSET_BASE_URL=https://qtknfcplbxgtmrzxocfu.supabase.co/storage/v1/object/public/assets
